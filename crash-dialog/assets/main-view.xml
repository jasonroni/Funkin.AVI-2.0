<vbox backgroundColor="#2B2B2B" width="500">
    <!-- <box width="500" height="100" style="background-color: red; border:1px solid red; background-opacity: .5" /> -->
    <image resource="assets/banner.png" />
    <vbox backgroundColor="#2B2B2B" style="padding: 5px; background-color: black" width="100%">
        <label id="message-label" text="Message" width="100%" textAlign="center" color="#FFFFFF" />
        <label color="#FFFFFF" text="Call stack:" />
        <scrollview backgroundColor="#121212" width="100%" height="200" contentWidth="100%">
            <vbox backgroundColor="#121212" style="padding: 2px;" width="100%">
                <label color="#FFFFFF" text="Call Stack" id="call-stack-label" />
            </vbox>
        </scrollview>
        <label color="#FFFFFF" text="Crash Reason" id="crash-reason-label" />
        <box width="100%">
            <button color="#FFFFFF" backgroundColor="#1C1C1C" horizontalAlign="left" id="view-crash-dump-button" text="View Crash Dump" />
            <button color="#FFFFFF" backgroundColor="#1C1C1C" horizontalAlign="center" id="restart-button" text="Restart" />
            <button color="#FFFFFF" backgroundColor="#1C1C1C" horizontalAlign="right" id="close-button" text="Close" />
        </box>
    </vbox>
</vbox>
